{
  "name": "@data-fair/catalogs",
  "version": "1.3.0",
  "description": "Import/publish datasets between Data Fair and other services.",
  "type": "module",
  "scripts": {
    "build-types": "df-build-types ./",
    "check-types": "tsc && npm -w ui run check-types",
    "dev-zellij": "df-dev zellij",
    "lint": "eslint . && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w ui run lint-fix",
    "prepare": "husky || true",
    "stop-dev-deps": "docker compose --profile '*' stop",
    "simulate": "playwright test -c playwright.sim.config.ts --project=simulate",
    "simulate:report": "dotenv -- node --experimental-strip-types --disable-warning=ExperimentalWarning simulations/report.ts",
    "test": "playwright test --max-failures=1",
    "test-unit": "playwright test --project unit --max-failures=1",
    "test-api": "playwright test --project api --max-failures=1",
    "test-e2e": "playwright test --project e2e --max-failures=1",
    "quality": "npm run lint && npm run build-types && npm -w ui run build && npm run check-types && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/data-fair/catalogs.git"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "api",
    "shared",
    "ui",
    "worker"
  ],
  "bugs": {
    "url": "https://github.com/data-fair/catalogs/issues"
  },
  "engines": {
    "node": "v24"
  },
  "dependencies": {
    "@data-fair/lib-types-builder": "^1.11.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@data-fair/lib-agents-sim": "^0.11.0",
    "@data-fair/lib-dev": "file:../lib_feat-dev-env/packages/dev",
    "@data-fair/lib-node": "^2.15.0",
    "@data-fair/lib-utils": "^1.14.0",
    "@json-layout/core": "~2.12.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.60.0",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "form-data": "^4.0.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.10",
    "tough-cookie": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "relativeDependencies": {
    "@data-fair/types-catalogs": "./types-catalogs",
    "@data-fair/lib-vue": "../lib/packages/vue",
    "@data-fair/lib-vuetify": "../lib/packages/vuetify"
  }
}
