# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 5800-5849 so that they rarely collide with other local services.
DEV_HOST=localhost
# the dev servers are on loopback: allowed to the SSRF-safe http clients of the api, the worker and the tests
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5800
DEV_API_PORT=5801
DEV_UI_PORT=5802
DEV_UI_HMR_PORT=5803
MONGO_PORT=5804
ES_PORT=5805
SD_PORT=5806
# the data-fair API, where the worker writes the imported datasets
DF_PORT=5807
# the registry API, where the api and the worker get the plugins
REGISTRY_PORT=5808
# optional services, the docker compose profiles events and agents (npm run dev -- --profile events). Without the
# events container the api and the worker log a failure per pushed event
EVENTS_PORT=5809
AGENTS_PORT=5810
# the Claude Code bridge of the simulations (npx --no df-agents-bridge)
BRIDGE_PORT=5811
MAILDEV_SMTP_PORT=5812
